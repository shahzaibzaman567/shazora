VITE_API_BASE_URL=http://localhost:5001/api
VITE_GOOGLE_AUTH_START_URL=http://localhost:5001/api/auth/google
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
# Free AI providers (set at least one on Vercel)
# Google Gemini free tier: ~10 RPM, 1500 requests/day
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-2.5-flash
# Groq free tier fallback: ~30 RPM, 1000 requests/day (get key at console.groq.com)
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=openai/gpt-oss-120b
